{
    "name": "i3bepb/reflection-for-test",
    "description": "Traits for invoking non-public methods and accessing non-public properties in tests",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "I3bepb\\ReflectionForTest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "I3bepb\\ReflectionForTest\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
